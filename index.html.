<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Fextoo 💘 Connection</title>

<style>
*{
  box-sizing:border-box;
}

body{
  margin:0;
  font-family:Arial,sans-serif;
  background:linear-gradient(135deg,#ff416c,#8e2de2);
  color:#333;
}

.container{
  max-width:500px;
  margin:auto;
  padding:25px 18px;
}

.card{
  background:white;
  border-radius:25px;
  padding:25px;
  box-shadow:0 10px 30px rgba(0,0,0,.25);
}

.logo{
  text-align:center;
  color:#ff416c;
  font-size:38px;
  font-weight:bold;
  margin-bottom:5px;
}

.subtitle{
  text-align:center;
  color:#777;
  margin-bottom:25px;
}

h2{
  text-align:center;
  color:#8e2de2;
}

label{
  display:block;
  margin-top:15px;
  font-weight:bold;
}

input,select{
  width:100%;
  padding:14px;
  margin-top:7px;
  border:1px solid #ddd;
  border-radius:12px;
  font-size:16px;
}

button{
  width:100%;
  padding:15px;
  margin-top:22px;
  border:none;
  border-radius:30px;
  background:linear-gradient(90deg,#ff416c,#8e2de2);
  color:white;
  font-size:18px;
  font-weight:bold;
  cursor:pointer;
}

button:hover{
  opacity:.9;
}

.info{
  margin-top:25px;
  padding:15px;
  background:#fff0f4;
  border-radius:15px;
  text-align:center;
}

footer{
  text-align:center;
  color:white;
  margin-top:20px;
  font-size:14px;
}
</style>
</head>

<body>

<div class="container">

  <div class="card">

    <div class="logo">Fextoo 💘</div>

    <div class="subtitle">
      Connect • Meet • Find Love ❤️
    </div>

    <h2>Join Fextoo</h2>

    <form onsubmit="joinFextoo(event)">

      <label>Full Name</label>
      <input type="text" id="name" placeholder="Enter your name" required>

      <label>Age</label>
      <input type="number" id="age" placeholder="Enter your age" min="18" required>

      <label>Gender</label>
      <select id="gender" required>
        <option value="">Select gender</option>
        <option>Male</option>
        <option>Female</option>
      </select>

      <label>Looking For</label>
      <select id="looking" required>
        <option value="">Select</option>
        <option>Relationship</option>
        <option>Friendship</option>
        <option>Marriage</option>
        <option>Connection</option>
      </select>

      <label>Phone Number</label>
      <input type="tel" id="phone" placeholder="07XXXXXXXX" required>

      <button type="submit">
        Join Fextoo 💘
      </button>

    </form>

    <div class="info">
      <strong>Fextoo 💘</strong><br>
      A place to meet new people and build meaningful connections.
    </div>

  </div>

  <footer>
    © 2026 Fextoo 💘 Connection Dating Site
  </footer>

</div>

<script>
function joinFextoo(event){
  event.preventDefault();

  const name = document.getElementById("name").value;
  const age = document.getElementById("age").value;

  if(age < 18){
    alert("You must be 18 or older to join Fextoo.");
    return;
  }

  alert(
    "Welcome to Fextoo 💘, " + name +
    "! Your registration has been received."
  );
}
</script>

</body>
</html>
